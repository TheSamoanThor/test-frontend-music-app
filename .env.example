# =============================================================
# Music Player — пример конфигурации сервера.
# Скопируйте этот файл в .env и заполните нужные поля.
# Все переменные опциональны. Пустые значения = локальный
# режим без пароля (как раньше).
# .env НЕ коммитится в git (см. .gitignore).
# =============================================================


# ---------- Основное ----------
# Адрес, на котором слушает сервер.
#   127.0.0.1 — только с этого компьютера
#   0.0.0.0   — со всех интерфейсов (для Docker/Amvera)
HOST=127.0.0.1

# Порт HTTP-сервера.
#
# Проверить, что порт 8000 свободен (Windows):
#   netstat -ano | findstr :8000
# Проверить на Linux/macOS:
#   lsof -i :8000
PORT=8000


# ---------- Пути (обычно менять не нужно) ----------
# Корень проекта: где лежат index.html, styles.css, js/, music/.
# BASE_DIR=.

# Путь к файлу SQLite (относительно BASE_DIR).
# DB_PATH=music.db

# Папка с аудиофайлами (относительно BASE_DIR).
# MUSIC_DIR=music

# Путь к логу сервера (создаётся, если LOG_ENABLED=true).
# LOG_PATH=server.log


# ---------- Логирование ----------
# Включать ли запись в server.log при старте.
# Дальше управляется из интерфейса «Настройки → Свой сервер».
LOG_ENABLED=false

# Максимальный размер лога до ротации (5 МБ).
LOG_MAX_BYTES=5242880

# Сколько последних строк сохранять после ротации.
LOG_KEEP_LINES=1000


# ---------- CORS / hosts ----------
# Для локального режима можно оставить *.
# Для Amvera укажите реальный домен проекта (через запятую, если несколько).
# Это отсекает запросы с чужим заголовком Host и разрешает куки только
# с ожидаемого origin.
#
# CORS_ORIGINS=https://your-project.amvera.io
# TRUSTED_HOSTS=your-project.amvera.io
CORS_ORIGINS=*
TRUSTED_HOSTS=*


# ---------- Режим Bearer-токена (устаревший, опционально) ----------
# Если задан — все изменяющие запросы требуют заголовок
#   Authorization: Bearer <SERVER_API_TOKEN>
# Оставьте пустым, если используете cookie-auth (ниже) — тогда
# сервер работает без пароля (открытый режим) или с cookie-логином.
#
# Команда генерации токена (один раз):
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVER_API_TOKEN=


# ---------- Лимиты ----------
# Максимальный размер одного загружаемого файла (МБ).
MAX_UPLOAD_MB=200

# GZip для JSON-ответов (уменьшает трафик).
ENABLE_GZIP=true

# Открывать ли /docs, /redoc, /openapi.json.
# В проде можно выключить.
ENABLE_DOCS=true


# ---------- Аутентификация (cookie + роли) ----------
# Пароли хранятся как bcrypt-хэши. НЕ пишите сюда пароль в открытом виде.
# Хэши генерируются скриптом make_passwords.py.
# Если оба хэша пусты — сервер работает в открытом режиме (без пароля).
#
# Команда генерации хэша для admin (интерактивно, пароль скрыт):
#   venv\Scripts\python.exe make_passwords.py admin
# Или неинтерактивно (пароль виден в истории команд — небезопасно):
#   venv\Scripts\python.exe make_passwords.py admin мой-пароль
# Скопируйте строку, начинающуюся с $2b$12$..., и вставьте ниже.
AUTH_ADMIN_USER=admin
AUTH_ADMIN_PASSWORD_HASH=

# Команда генерации хэша для listener:
#   venv\Scripts\python.exe make_passwords.py listener
AUTH_LISTENER_USER=listener
AUTH_LISTENER_PASSWORD_HASH=

# Секрет для подписи cookie. Длинная случайная строка.
# Без неё cookie-auth не включается, и сервер работает в открытом режиме.
#
# Команда генерации (Windows, cmd.exe):
#   venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(48))"
# Команда генерации (Linux / macOS / Git Bash):
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Команда генерации (PowerShell):
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
#
# Скопируйте вывод (≈64 символа) и вставьте после '=' без кавычек.
AUTH_SESSION_SECRET=

# Срок жизни cookie в часах (168 = неделя).
AUTH_SESSION_TTL_HOURS=168

# Имя cookie. Менять не обязательно.
AUTH_COOKIE_NAME=mp_session

# Secure-флаг cookie.
#   true  — cookie передаётся только по HTTPS (для Amvera / реального домена)
#   false — для локальной отладки на http://localhost
# При HOST=127.0.0.1 или localhost сервер сам по умолчанию ставит false,
# если переменная не задана. Но если переменная задана явно — она
# переопределяет автоопределение, поэтому для локальных тестов ставьте false.
AUTH_COOKIE_SECURE=false
