# ---- сервер ----
HOST=127.0.0.1
PORT=8000

# ---- пути (обычно менять не нужно) ----
# BASE_DIR=.
# DB_PATH=music.db
# MUSIC_DIR=music
# LOG_PATH=server.log

# ---- логирование ----
LOG_ENABLED=false
LOG_MAX_BYTES=5242880
LOG_KEEP_LINES=1000

# ---- CORS / hosts ----
# Для Amvera укажите реальный домен проекта, чтобы отсечь запросы
# с произвольным Host. Оставьте * только для локального режима.
# CORS_ORIGINS=https://your-project.amvera.io
# TRUSTED_HOSTS=your-project.amvera.io
CORS_ORIGINS=*
TRUSTED_HOSTS=*

# ---- auth (опционально) ----
# Если задан — все изменяющие запросы требуют Authorization: Bearer <token>
# Оставьте пустым для локального режима без пароля.
SERVER_API_TOKEN=

# ---- лимиты ----
MAX_UPLOAD_MB=200
ENABLE_GZIP=true
ENABLE_DOCS=true

# ---- auth ----
# Пароли хранятся как bcrypt-хэши. Задаются в .env и читаются при старте.
# Если оба пусты — сервер работает в открытом режиме (как сейчас).
AUTH_ADMIN_USER=admin
AUTH_ADMIN_PASSWORD_HASH=
AUTH_LISTENER_USER=listener
AUTH_LISTENER_PASSWORD_HASH=

# Секрет для подписи сессионных cookie.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_HOURS=168      # неделя
AUTH_COOKIE_NAME=mp_session
AUTH_COOKIE_SECURE=true         # false только для локальной отладки по http
